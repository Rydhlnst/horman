# The token contract (mint) address shown by the Copy CA buttons and used for the holder
# check. Leave empty until launch; the buttons then say it is announced at launch. Set it in
# Vercel and redeploy, since NEXT_PUBLIC_ values are built into the pages.
NEXT_PUBLIC_CA=

# Signs the wallet sign-in session cookie. A long random string (32+ characters).
SESSION_SECRET=

# Solana RPC used on the server to read $HORMAN balances. The public endpoint works for
# light use; a provider such as Helius is better under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# OpenRouter key for the chat models (/api/chat). lib/models.ts picks the newest model for
# each tier from OpenRouter's live list.
OPENROUTER_API_KEY=

# Wallets that count as $HORMAN holders before launch, for testing (comma separated).
HOLDER_ALLOWLIST=

# ZEC top-ups through NOWPayments. Both are set in the NOWPayments dashboard; the IPN
# callback URL is https://horman.dev/api/pay/ipn. Top-ups stay closed until both are set
# and a database is connected.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional: https://api-sandbox.nowpayments.io/v1 for sandbox testing.
NOWPAYMENTS_BASE_URL=

# Postgres for credit balances and payments. Vercel's Neon integration sets it; tables are
# created on first use.
DATABASE_URL=
